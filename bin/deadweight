#!/usr/bin/env python3
"""Show the detail behind the status line, and set that status line up.

THE GAP THIS FILLS. A status line that says "3W" and offers no way to see which
three warnings is a number without a referent: it can only be believed or
ignored, and a number that can only be believed is not a measurement. The audit
already ran at session start and its findings are already cached, so showing the
detail costs nothing - only a second run would.

Python only, standard library only - the same dependency the audit already has.
An earlier version piped through `jq`, which was a dependency the README did not
declare and which fails silently where it is missing.

    deadweight                   cached findings for this project, errors first
    deadweight --errors          errors only
    deadweight --info            also the measurements (INFO), which the default leaves out
    deadweight --fresh           measure now, rewrite the cache the status line reads, show it
    deadweight --json            the raw cached report
    deadweight --setup-statusline  install the status line in Claude Code and/or Copilot CLI
    deadweight --where           print this plugin's root (to alias the command)
"""
from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
PLUGIN_ROOT = HERE.parent
AUDIT = PLUGIN_ROOT / "skills" / "config-auditor" / "scripts" / "audit.py"
TEMPLATE = PLUGIN_ROOT / "skills" / "config-auditor" / "templates" / "statusline.py"
LAUNCHER = PLUGIN_ROOT / "skills" / "config-auditor" / "templates" / "statusline-launcher.py"

RED, YEL, GRN, DIM, OFF = "\033[31m", "\033[33m", "\033[32m", "\033[2m", "\033[0m"
HOOK = PLUGIN_ROOT / "hooks" / "session-audit.py"


def statusline_module():
    """The status line's own helpers, so the line and this command cannot disagree."""
    import importlib.util
    spec = importlib.util.spec_from_file_location("deadweight_statusline", TEMPLATE)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def remedy(root: Path, d: dict) -> str | None:
    """What clears the `↻`, decided here because only here is the current auditor known.

    The status line compares two shas and cannot tell which side is older. When the
    MEASUREMENT is older (the configuration moved, or the plugin was updated since),
    measuring again fixes it. When the FLOOR is older, measuring again changes
    nothing - the floor has to be re-set, deliberately, after reading both counts.
    """
    sl = statusline_module()
    cache = cache_path(root)
    current = hashlib.sha256(AUDIT.read_bytes()).hexdigest()[:8]
    if sl.config_touched_since(str(root), cache.stat().st_mtime) or d.get("audit_sha") != current:
        return "the measurement is older than the configuration or the auditor: `deadweight --fresh`"
    floor = sl.read(str(root / ".claude" / "audit" / "floor.json"))
    if floor and floor.get("audit_sha") != d.get("audit_sha"):
        return (f"the floor was set by another auditor (`{floor.get('audit_sha')}`, now "
                f"`{d.get('audit_sha')}`): read both counts, then `audit.py --set-floor`")
    return None


def cache_path(root: Path) -> Path:
    base = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "claude-audit"
    return base / f"{root.name}-{hashlib.md5(str(root).encode()).hexdigest()[:8]}.json"


def claude_home() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def copilot_home() -> Path:
    return Path(os.environ.get("COPILOT_HOME") or Path.home() / ".copilot")


def wire(settings: Path, wanted: dict) -> int:
    """Set `statusLine` in one settings file. 0 set, 1 another line is there, 2 unreadable.

    An unparsable file is left alone rather than rewritten: Copilot's settings.json
    accepts comments, and rewriting it through `json` would delete them.
    """
    data = {}
    if settings.is_file():
        try:
            data = json.loads(settings.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, UnicodeDecodeError):
            print(f"  {settings} is not plain JSON (comments?); not touching it.", file=sys.stderr)
            return 2
    existing = data.get("statusLine")
    if existing and existing != wanted:
        print(f"  {settings} already has a statusLine:\n    {json.dumps(existing)}\n"
              f"  Left untouched. To keep yours, add the audit to it (README, "
              f"\"Already have a status line?\").", file=sys.stderr)
        return 1
    data["statusLine"] = wanted
    settings.parent.mkdir(parents=True, exist_ok=True)
    settings.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return 0


def place_launcher(dest: Path) -> None:
    # The launcher, not the template: a copied template stays at the version of the
    # day it was copied, and 0.13.0's notices never reached the lines set up before it.
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(LAUNCHER.read_text(encoding="utf-8"), encoding="utf-8")
    dest.chmod(0o755)


def setup_claude(root: Path) -> int:
    """Claude Code reads `statusLine` from the project: one line per project."""
    if not ((root / ".git").exists() or (root / ".claude").is_dir()):
        print(f"Claude Code: {root} is not a project (no .git, no .claude/); skipped.\n"
              f"  Run the setup from the project's root.", file=sys.stderr)
        return 1
    dest = root / ".claude" / "statusline.py"
    place_launcher(dest)
    code = wire(root / ".claude" / "settings.json",
                {"type": "command", "command": 'python3 "$CLAUDE_PROJECT_DIR"/.claude/statusline.py'})
    if code == 0:
        print(f"Claude Code: installed for this project\n  {dest}\n  statusLine set in {root / '.claude' / 'settings.json'}")
    return code


def setup_copilot() -> int:
    """Copilot CLI reads `statusLine` from the user's settings only.

    A repository's .github/copilot/settings.json does not honour the key - set there,
    it is ignored without a word. So there is one line for every project, and the
    launcher finds the project from the directory Copilot runs it in.
    """
    home = copilot_home()
    dest = home / "deadweight-statusline.py"
    place_launcher(dest)
    code = wire(home / "settings.json",
                {"type": "command", "command": f'python3 "{dest}" copilot'})
    if code == 0:
        print(f"Copilot CLI: installed for every project\n  {dest}\n  statusLine set in {home / 'settings.json'}")
    return code


def setup_statusline(root: Path) -> int:
    """Wire the status line into every host found on this machine.

    A plugin cannot ship a `statusLine` setting: a plugin's own settings.json only
    honours `agent` and `subagentStatusLine`, in Claude Code as in Copilot CLI. So
    the wiring has to happen outside the plugin - a manual step unless something does
    it, and a manual step described with a `<placeholder>` path is where a plugin
    loses its user. The two hosts do not keep the key at the same level, which is why
    one command writes two different things.
    """
    # Without CLAUDE_PROJECT_DIR the project is the working directory, and an agent
    # that cd's into bin/ to run this script makes the plugin its own project.
    if root == PLUGIN_ROOT or PLUGIN_ROOT in root.parents:
        print(f"{root} is inside the plugin itself; nothing written.\n"
              f"  Run the setup from the root of the project to equip.", file=sys.stderr)
        return 2
    hosts = []
    if claude_home().is_dir():
        if root / ".claude" == claude_home():
            print("Claude Code: the home directory is not a project; skipped.", file=sys.stderr)
            hosts.append(1)
        else:
            hosts.append(setup_claude(root))
    if copilot_home().is_dir():
        hosts.append(setup_copilot())
    if not hosts:
        print(f"Neither Claude Code ({claude_home()}) nor Copilot CLI ({copilot_home()}) "
              f"was found; nothing written.", file=sys.stderr)
        return 1
    if 0 in hosts:
        print("It shows up on the next session.")
    return max(hosts)


def show(root: Path, only_errors: bool, as_json: bool, with_info: bool = False) -> int:
    src = cache_path(root)
    if not src.is_file() or src.stat().st_size == 0:
        print(f"No cached measurement for {root}.\n"
              f"The SessionStart hook writes it when a session opens here; "
              f"`deadweight --fresh` measures now.")
        return 1
    if as_json:
        print(src.read_text(encoding="utf-8"), end="")
        return 0
    try:
        d = json.loads(src.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, UnicodeDecodeError):
        print(f"Cached report at {src} is unreadable.", file=sys.stderr)
        return 2
    e, w, n = d.get("errors", 0), d.get("warnings", 0), d.get("notices", 0)
    col = RED if e else (YEL if w else GRN)
    print(f"{col}{d.get('project')}  {e}E {w}W {n}n{OFF}{DIM}   audit {d.get('audit_sha')}"
          f" ({d.get('plugin_version') or '?'})   measured {d.get('measured_at')}{OFF}")
    fix = remedy(root, d)
    if fix:
        print(f"{YEL}↻ {fix}{OFF}")
    newer = statusline_module().update_available(str(root))
    if newer:
        print(f"{YEL}↑ {newer} is available: `claude plugin update deadweight`{OFF}")
    print()
    rang = {"ERROR": 0, "WARN": 1, "NOTICE": 2, "INFO": 3}
    every = d.get("findings") or []
    found = [f for f in every
             if (f.get("severity") == "ERROR" if only_errors
                 else f.get("severity") != "INFO" or with_info)]
    mesures = sum(f.get("severity") == "INFO" for f in every)
    if not found:
        print("  (nothing to report)")
    for f in sorted(found, key=lambda x: rang.get(x.get("severity"), 4)):
        c = {"ERROR": RED, "WARN": YEL}.get(f.get("severity"), DIM)
        print(f"  {c}[{f.get('severity')}]{OFF} {f.get('check')}")
        print(f"      {f.get('message')}")
        print(f"      {DIM}{f.get('location')}{OFF}")
    if mesures and not with_info and not only_errors:
        print(f"\n  {DIM}{mesures} measurement(s) not shown: `deadweight --info`{OFF}")
    return 0


def main(argv: list[str]) -> int:
    # Windows writes a piped stdout in the ANSI code page (cp1252), which has no
    # `↻` or `↑`: the first one raised UnicodeEncodeError and the command stopped mid-report. Measured on a
    # Windows runner, 2026-09-24. Every reader of this output - the host, an agent's
    # shell tool, a modern terminal - decodes UTF-8.
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")
    # Outside Claude Code nothing names the project, and the working directory may
    # be a subfolder of it: walk up the way the status line does, so the command and
    # the line find the same cache. A path given as an argument is taken as is.
    cwd = Path.cwd().resolve()
    named = os.environ.get("CLAUDE_PROJECT_DIR")
    root = Path(named) if named else Path(statusline_module().project_of(str(cwd)))
    fresh = errors = as_json = setup = with_info = False
    for a in argv:
        if a == "--fresh":                   fresh = True
        elif a == "--errors":                errors = True
        elif a == "--info":                  with_info = True
        elif a == "--json":                  as_json = True
        elif a == "--setup-statusline":      setup = True
        elif a == "--where":                 print(PLUGIN_ROOT); return 0
        elif a in ("-h", "--help"):          print(__doc__); return 0
        elif not a.startswith("-"):          root = Path(a).expanduser()
        else:
            print(f"unknown option: {a}", file=sys.stderr); return 2
    root = root.resolve()

    if setup:
        # The guard looks at where the command was run too: from bin/, the walk up
        # would leave the plugin and land on whatever encloses it.
        if cwd == PLUGIN_ROOT or PLUGIN_ROOT in cwd.parents:
            root = cwd
        return setup_statusline(root)
    if fresh:
        # Through the hook, so there is one writer of the cache and one format. An
        # earlier `--fresh` ran the audit and printed it, and left the cache - and
        # the `↻` it had just told the reader to clear - exactly as it was.
        env = dict(os.environ, CLAUDE_PROJECT_DIR=str(root), CLAUDE_PLUGIN_ROOT=str(PLUGIN_ROOT))
        subprocess.call([sys.executable, str(HOOK)], env=env)
    return show(root, errors, as_json, with_info)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
