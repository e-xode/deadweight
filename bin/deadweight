#!/usr/bin/env bash
# Show the detail behind the status line.
#
# THE GAP THIS FILLS. A status line that says "3W" and offers no way to see which
# three warnings is a number without a referent: it can only be believed or
# ignored, and a number that can only be believed is not a measurement. The audit
# already ran at session start and its findings are already in the cache, so the
# detail costs nothing to show - only a second run would.
#
# This directory is on the Bash tool's PATH while the plugin is enabled, so Claude
# can run `deadweight` by name. To run it yourself, alias it once:
#   alias deadweight='"$(ls -d ~/.claude/plugins/*/deadweight*/bin/deadweight | head -1)"'
#
#   deadweight               the cached findings for this directory
#   deadweight --fresh       re-run the audit now instead of reading the cache
#   deadweight --errors      errors only
#   deadweight --json        the raw report
set -uo pipefail

ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUDIT="$HERE/../skills/config-auditor/scripts/audit.py"
FRESH=0; ONLY_ERR=0; AS_JSON=0
for a in "$@"; do
  case "$a" in
    --fresh)  FRESH=1 ;;
    --errors) ONLY_ERR=1 ;;
    --json)   AS_JSON=1 ;;
    -h|--help) sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) ROOT="$a" ;;
  esac
done

if [ "$FRESH" = 1 ]; then
  [ -f "$AUDIT" ] || { echo "audit.py introuvable a $AUDIT" >&2; exit 2; }
  if [ "$AS_JSON" = 1 ]; then exec python3 "$AUDIT" --root "$ROOT" --json; fi
  exec python3 "$AUDIT" --root "$ROOT"
fi

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-audit"
SRC="$CACHE/$(basename "$ROOT")-$(printf '%s' "$ROOT" | cksum | cut -d' ' -f1).json"
if [ ! -s "$SRC" ]; then
  echo "Aucune mesure en cache pour $ROOT."
  echo "Le hook SessionStart ecrit ce fichier a l'ouverture d'une session; « deadweight --fresh » mesure maintenant."
  exit 1
fi
[ "$AS_JSON" = 1 ] && exec cat "$SRC"

jq -r --argjson onlyerr "$ONLY_ERR" '
  "\(.project)  \(.errors)E \(.warnings)W   audit \(.audit_sha)   mesure \(.measured_at)",
  "",
  ( .findings
    | map(select($onlyerr == 0 or .severity == "ERROR"))
    | if length == 0 then ["  (rien a signaler)"]
      else sort_by(if .severity == "ERROR" then 0 else 1 end)
           | map("  [\(.severity)] \(.check)\n      \(.message)\n      \(.location)")
      end
    | .[] )
' <"$SRC"
